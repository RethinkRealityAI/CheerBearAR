# Cheer Bear AR: server-side settings. Names only, no values. On Netlify set them in
# Site configuration > Environment variables (scope: Functions). Locally, copy this file to .env and fill in what you
# have: everything is optional for `npm run dev`; missing services show "not set up" or use the demo call.
# Nothing here is ever sent to the browser.

# --- Twilio voice (calls from the browser through our TwiML app) -----------------------------------------------
# Account SID (starts with AC).
TWILIO_ACCOUNT_SID=
# API key SID (starts with SK) used to sign browser access tokens.
TWILIO_API_KEY_SID=
# The secret of that API key.
TWILIO_API_KEY_SECRET=
# TwiML app SID (starts with AP); its Voice URL must be https://<site>/api/voice (HTTP POST).
TWILIO_TWIML_APP_SID=
# Auth token: checks X-Twilio-Signature on /api/voice and sends SMS. Strongly recommended in production.
TWILIO_AUTH_TOKEN=
# Our Twilio number (E.164, e.g. +18005550100): caller ID for calls and the "from" number for SMS.
TWILIO_PHONE_NUMBER=
# Optional: a different "from" number for SMS (defaults to TWILIO_PHONE_NUMBER).
TWILIO_SMS_FROM=
# Cheer Bear's real phone number (E.164): what the call dials and where chat SMS goes.
CHEER_BEAR_NUMBER=
# Optional: comma-separated extra numbers or client:<identity> the TwiML app may dial (everything else is refused).
ALLOWED_DIAL_TARGETS=
# Optional: "false" stops recording calls (the old server recorded from answer; default true).
TWILIO_RECORD_CALLS=
# Optional: the exact public Voice URL Twilio signs, if signature checks fail behind a custom domain or proxy.
TWILIO_WEBHOOK_URL=

# --- OpenAI (live transcription of Cheer Bear + optional intent fallback) ---------------------------------------
# API key; stays on the server, the browser only ever gets 2-minute client secrets.
OPENAI_API_KEY=
# Optional: Realtime transcription model (default gpt-4o-mini-transcribe; gpt-live-transcribe also supported).
OPENAI_TRANSCRIBE_MODEL=
# Optional: model for the hybrid/openai intent engines (default gpt-4o-mini).
OPENAI_INTENT_MODEL=
# Optional: API base URL (default https://api.openai.com/v1; used by tests to point at a fake).
OPENAI_BASE_URL=

# --- Admin panel (/admin) -----------------------------------------------------------------------------------------
# Admin user name. Required on any deployed site.
ADMIN_USERNAME=
# Admin password (10+ characters) or a bcrypt hash of it. admin/admin is refused on deployed sites.
ADMIN_PASSWORD=
# Secret that signs admin sessions: 32+ random characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# --- Optional / local development ------------------------------------------------------------------------------
# Extra origins allowed to call /api (comma-separated), e.g. a second custom domain. Same-origin is always allowed.
ALLOWED_ORIGINS=
# Config storage override: blobs | file | memory (default: Netlify Blobs when deployed, a .tmp/ file under npm run dev).
CHEERBEAR_STORE=
# Folder for CHEERBEAR_STORE=file (default .tmp/config-store).
CHEERBEAR_STORE_DIR=
# Port for the local functions runner (default: Vite port + 1000, i.e. 6173).
API_PORT=
