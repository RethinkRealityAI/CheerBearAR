{
  "name": "cheer-bear-ar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false --include 'netlify/**' --include 'src/shared/**' scripts/dev-api.ts",
    "test:server": "tsx scripts/check-classifier.ts && tsx scripts/check-config.ts && tsx scripts/check-voice-logic.ts && tsx scripts/check-functions.ts",
    "test:voice": "tsx scripts/check-voice-browser.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@netlify/blobs": "^11.1.9",
    "@netlify/functions": "^6.1.1",
    "@twilio/voice-sdk": "^2.19.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.75.0",
    "openai": "^7.60.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "three": "^0.180.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
